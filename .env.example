# Copy to .env and fill in. .env is git-ignored - nothing here is committed.

# Public IP of the k3s node (empty = auto-detect)
SERVER_IP=
# Base domain for all hostnames (empty = <SERVER_IP>.sslip.io)
BASE_DOMAIN=
# Rancher UI hostname (empty = rancher.<BASE_DOMAIN>)
RANCHER_HOSTNAME=

LETSENCRYPT_EMAIL=you@example.com
# Initial admin password for the Rancher UI (you'll be asked to change it on first login)
RANCHER_BOOTSTRAP_PASSWORD=change-me-please

# GitOps: public GitHub repo Fleet will deploy from (leave as-is to skip)
GIT_REPO_URL=https://github.com/<user>/<repo>.git
GIT_BRANCH=main
