# Copy to .env and fill in. .env is git-ignored - nothing here is committed.

# Public IP of the k3s node (empty = auto-detect)
SERVER_IP=
# Base domain for all hostnames (empty = <SERVER_IP>.sslip.io)
BASE_DOMAIN=
# Argo CD UI hostname (empty = argocd.<BASE_DOMAIN>)
ARGOCD_HOSTNAME=

# GitOps: public GitHub repo Argo CD deploys from (leave the quoted placeholder to skip)
GIT_REPO_URL="https://github.com/<user>/<repo>.git"   # keep the quotes while it is a placeholder
GIT_BRANCH=main
